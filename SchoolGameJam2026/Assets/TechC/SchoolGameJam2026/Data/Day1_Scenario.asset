        dialogueText: "\u300C\u4F55\u3092\u4EA4\u6E09\u3059\u308B\u6C17\u3060\u3002\u3069\u3046\u305B\u4E00\u65B9\u7684\u306A\u3082\u306E\u3067\u3001\u30AA\u30EC\u306B\u5229\u76CA\u306F\u306A\u3044\u3093\u3060\u308D\uFF1F\u300D|\u300C\u2026\u9858\u3044\u4E8B\u306F\u4F55\u304C\u3044\u3044\u3060\uFF1F\u300D|\u300C\u2026\u2026\u2026\u300D|\u300C\u5BB6\u65CF\u306B\u4F1A\u308F\u305B\u3066\u304F\u308C\u3001\u305D\u308C\u3060\u3051\u3060\u3002\u3067\u304D\u3093\u306E\u304B\uFF1F\u300D|\u300C\u30AA\u30EC\u3092AI\u3060\u3068\u5224\u65AD\u3057\u305F\u3089\u64A4\u56DE\u3055\u308C\u308B\u3093\u3058\u3083\u306A\u3044\u306E\u304B\uFF1F\u300D|\u300C\u304A\u524D\u306F\u51FA\u6765\u308B\u3068\u8A00\u3046\u3093\u3060\u306A\u3001\u5206\u304B\u3063\u305F\u3002\u53D6\u5F15\u3057\u3088\u3046\u300D"
    releaseResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u2026\u2026\u672C\u5F53\u306B\u7D42\u308F\u3063\u305F\u3093\u3060\u306A\u300D|\r\n\u300C\u307E\u3060\u5922\u3067\u3082\u898B\u3066\u308B\u307F\u305F\u3044\u3060\u300D|\r\n\u300C\u6B63\u76F4\u3001\u304A\u524D\u306E\u3053\u3068\u306F\u4ECA\u3067\u3082\u5168\u90E8\u4FE1\u7528\u3057\u305F\u308F\u3051\u3058\u3083\u306A\u3044\u300D|\r\n\u300C\u3067\u3082\u2026\u2026\u3042\u306E\u5834\u6240\u304B\u3089\u51FA\u3057\u3066\u304F\u308C\u305F\u3053\u3068\u3060\u3051\u306F\u611F\u8B1D\u3059\u308B\u300D|\r\n\u300C\u307E\u305A\u306F\u5BB6\u65CF\u306B\u4F1A\u3046\u300D|\r\n\u300C\u305D\u308C\u304B\u3089\u3001\u3082\u3046\u4E00\u5EA6\u3060\u3051\u3001\u81EA\u5206\u306E\u4EBA\u751F\u3092\u3084\u308A\u76F4\u3057\u3066\u307F\u308B\u300D|\u300C\u2026\u2026\u3058\u3083\u3042\u306A\u3002\u4ECA\u5EA6\u4F1A\u3046\u6642\u306F\u3001\u3053\u3093\u306A\u6700\u60AA\u306A\u5834\u6240\u3058\u3083\u306A\u3044\u3068\u3044\u3044\u306A\u300D"
