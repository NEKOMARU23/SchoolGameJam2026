    valueContent: "\u5E7C\u5C11\u671F\uFF1A\r\n\u7236\u5B50\u5BB6\u5EAD\u3067\u80B2\u3063\u305F\u3002\r\n\u8981\u9818\u304C\u826F\u304F\u3001\u7236\u306E\u6559\u80B2\u3082\u5B66\u6821\u306E\u52C9\u5F37\u3082\u305D\u3064\u306A\u304F\u3053\u306A\u3057\u3001\u81EA\u7531\u6642\u9593\u3092\u898B\u3064\u3051\u3066\u306F\u904A\u3093\u3067\u904E\u3054\u3057\u3066\u3044\u305F\u3002"
    unlockCost: 50
  - itemKey: PAST_2
    valueContent: "\u9752\u5E74\u671F\uFF1A\r\n\u6BCD\u306B\u3064\u3044\u3066\u306E\u8A18\u61B6\u306F\u306A\u304F\u7236\u3082\u8A71\u305D\u3046\u3068\u3057\u306A\u3044\u304C\u3001\u672C\u4EBA\u306F\u4F55\u6545\u81EA\u8EAB\u306B\u6BCD\u304C\u3044\u306A\u3044\u306E\u304B\u8208\u5473\u3092\u6301\u3063\u3066\u304A\u308A\u3001\u72EC\u81EA\u3067\u8ABF\u67FB\u3092\u3057\u3066\u3044\u304F\u3046\u3061\u306B\u60C5\u5831\u3092\u96C6\u3081\u308B\u697D\u3057\u3055\u3092\u77E5\u308B\u3002\r\n\u5927\u5B66\u3067\u306F\u65B0\u805E\u90E8\u3068\u3057\u3066\u591A\u304F\u306E\u8A18\u4E8B\u3092\u4F5C\u3063\u305F\u3002\u8CDB\u5426\u4E21\u8AD6\u306F\u3042\u3063\u305F\u304C\u3001\u5B66\u5185\u3067\u5F7C\u5973\u306E\u8A18\u4E8B\u306F\u4E00\u3064\u306E\u8A71\u984C\u3068\u3057\u3066\u8AAD\u307E\u308C\u3066\u3044\u305F\u3002"
