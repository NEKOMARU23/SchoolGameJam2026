  - itemKey: PAST_3
    valueContent: "\u73FE\u5728\uFF1A\r\n\u60C5\u5831\u53CE\u96C6\u80FD\u529B\u306E\u9AD8\u3055\u3092\u8CB7\u308F\u308C\u3066\u30B8\u30E3\u30FC\u30CA\u30EA\u30B9\u30C8\u3068\u3057\u3066\u6D3B\u8E8D\u3002\r\n\u771F\u5B9F\u306B\u56FA\u57F7\u3057\u3066\u304A\u308A\u3001\u3042\u3089\u3086\u308B\u60C5\u5831\u3092\u8CB7\u3063\u3066\u81EA\u5206\u306E\u6E80\u8DB3\u3059\u308B\u8A18\u4E8B\u3092\u66F8\u3044\u3066\u3044\u308B\u3002\u307E\u305F\u305D\u308C\u306B\u5229\u76CA\u304C\u3042\u308B\u306E\u3067\u3001\u8A18\u4E8B\u306B\u3088\u3063\u3066\u793E\u4F1A\u7684\u306B\u5B64\u7ACB\u305B\u3056\u308B\u3092\u5F97\u306A\u3044\u4EBA\u305F\u3061\u304C\u51FA\u3066\u3082\u898F\u5236\u3055\u308C\u308B\u3053\u3068\u306F\u306A\u3044\u3002"
