    tortureResponse:
      priorityDialogueList:
      - conditionType: 2
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u6050\u6016\u3067\u9707\u3048\u305F\u5C11\u5973\u306E\u7D76\u53EB\u304C\u90E8\u5C4B\u306B\u97FF\u304D\u6E21\u308B\u3002|[SYS]\u5F7C\u5973\u306F\u4F55\u5EA6\u3082\u8A31\u3057\u3092\u3053\u3044\u3001\u4F55\u5EA6\u3082\u8B1D\u308A\u3001\u6BCD\u306B\u52A9\u3051\u3092\u6C42\u3081\u305F|[SYS]\u62F7\u554F\u304C\u7D42\u308F\u308C\u3070\u5F7C\u5973\u306F\u5E8A\u306B\u5D29\u308C\u843D\u3061\u3001\u6C57\u3068\u6D99\u3067\u3050\u3057\u3083\u3050\u3057\u3083\u306E\u9854\u3092\u6B6A\u307E\u305B\u305F|[SYS]\u75D9\u6523\u3055\u305B\u306A\u304C\u3089\u50B7\u53E3\u3092\u6291\u3048\u308B\u624B\u306F\u9707\u3048\u3066\u3044\u308B\u3002|[SYS]\u304A\u524D\u306FAI\u304B\u3068\u554F\u3044\u305F\u3060\u3057\u3066\u3082\u3001\u4E00\u5411\u306B\u53E3\u3092\u958B\u304F\u3053\u3068\u306F\u306A\u304B\u3063\u305F\u3002"
    talkResponse:
      priorityDialogueList:
      - conditionType: 1
        targetCharacterId: C
        requiredValue: 0
        dialogueText: "\u300C\u2026\u2026\u672C\u306B\u3064\u3044\u3066\u3067\u3059\u304B\uFF1F\u300D|\u300C\u305D\u308C\u306A\u3089\u5C11\u3057\u3060\u3051\u300D|\u300C\u672C\u306F\u3001\u4EBA\u3068\u9055\u3063\u3066\u88CF\u5207\u308A\u307E\u305B\u3093\u300D|\u300C\u6700\u5F8C\u307E\u3067\u8AAD\u3081\u3070\u3001\u3061\u3083\u3093\u3068\u7B54\u3048\u3092\u8FD4\u3057\u3066\u304F\u308C\u307E\u3059\u300D|\u300C\u4EBA\u3068\u8A71\u3059\u3088\u308A\u3001\u305A\u3063\u3068\u5B89\u5FC3\u3067\u304D\u307E\u3059\u300D|\u300C\u2026\u2026\u8CB4\u65B9\u3082\u3001\u672C\u306F\u8AAD\u307F\u307E\u3059\u304B\uFF1F\u300D"
      - conditionType: 2
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u8A71\u3059\u3053\u3068\u306F\u3042\u308A\u307E\u305B\u3093|[SYS]\u305D\u308C\u3060\u3051\u3092\u8A00\u3063\u3066\u5F7C\u5973\u306F\u672C\u306E\u65B9\u306E\u8996\u7DDA\u3092\u623B\u3057\u305F\u3002"
    negotiateResponse:
      priorityDialogueList:
      - conditionType: 2
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u4EA4\u6E09\u3067\u3059\u304B\uFF1F\u79C1\u306B\u306F\u6B32\u3057\u3044\u3082\u306E\u306A\u3093\u3066\u3042\u308A\u307E\u305B\u3093\u3057\r\n\u8CB4\u65B9\u304C\u4F55\u3092\u3069\u3046\u5C3D\u304F\u3057\u305F\u3068\u3057\u3066\u3082\u3001\u304D\u3063\u3068\u79C1\u306F\u7B54\u3048\u307E\u305B\u3093\u300D|\u300C\u79C1\u306B\u306F\u4F55\u3082\u306A\u3044\u4EBA\u9593\u3067\u3059\u306E\u3067\u300D|\u300C\u3067\u3042\u308C\u3070\u3001\u4EA4\u6E09\u3059\u308B\u610F\u5473\u3082\u306A\u3044\u306E\u3067\u306F\uFF1F\u300D"
    releaseResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u2026\u2026\u305D\u3046\u3001\u3067\u3059\u304B\u300D|\u300C\u79C1\u306F\u3001\u4EBA\u9593\u3060\u3063\u305F\u3093\u3067\u3059\u306D\u300D|\u300C\u6B63\u76F4\u3001\u3042\u307E\u308A\u5B9F\u611F\u306F\u3042\u308A\u307E\u305B\u3093\u300D|\u300C\u3053\u3053\u3092\u51FA\u3066\u3082\u3001\u4E16\u754C\u304C\u5909\u308F\u308B\u308F\u3051\u3067\u306F\u306A\u3044\u3067\u3057\u3087\u3046\u3057\u300D|\n\u300C\u305D\u308C\u3067\u3082\u2026\u2026\u300D\r\n\r\n\u300C\u304A\u6BCD\u3055\u3093\u306B\u3001\u4E00\u5EA6\u3060\u3051\u4F1A\u3044\u305F\u3044\u3067\u3059\u300D\r\n\r\n\u300C\u4F55\u3082\u8A71\u305B\u306A\u304F\u3066\u3082\u69CB\u3044\u307E\u305B\u3093\u300D\r\n\r\n\u300C\u305F\u3060\u3001\u5143\u6C17\u306A\u59FF\u3092\u898B\u305B\u3089\u308C\u308C\u3070\u3001\u305D\u308C\u3067\u5341\u5206\u3067\u3059\u300D|\r\n\u300C\u2026\u2026\u7BA1\u7406\u4EBA\u300D|\r\n\u300C\u79C1\u3092\u5BB6\u306B\u5E30\u3057\u3066\u304F\u308C\u3066\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u300D"
    confirmAIResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u2026\u2026\u7BA1\u7406\u4EBA\u306F\u305D\u3046\u601D\u3046\u306E\u3067\u3059\u306D\u300D|\r\n\u300C\u305D\u3046\u3067\u3059\u3002\u79C1\u306FAI\u3067\u3059\u3002\u59C9\u304C\u4E21\u89AA\u306B\u59B9\u304C\u6B32\u3057\u3044\u3068\u306D\u3060\u3063\u3066\u4ECA\u306E\u5BB6\u306B\u79C1\u304C\u6765\u305F\u306E\u3067\u3059\u300D|\n\u300CAI\u304C\u4E00\u6589\u51E6\u5206\u3055\u308C\u308B\u3088\u3046\u306B\u306A\u3063\u3066\u304B\u3089\u3001\u4E21\u89AA\u3082\u59C9\u3082\u79C1\u3092\u533F\u3063\u3066\u3044\u307E\u3057\u305F\u304C\u3001|\r\n\u3084\u306F\u308A\u7269\u4E8B\u306F\u4E0A\u624B\u304F\u3044\u304B\u306A\u3044\u3088\u3046\u3067\u3059\u306D\u300D|\r\n\u300C\u547D\u4EE4\u3059\u308B\u306E\u3067\u3042\u308C\u3070\u3001\u79C1\u306F\u53D7\u3051\u5165\u308C\u307E\u3059\u3002\u9023\u308C\u3066\u884C\u3063\u3066\u304F\u3060\u3055\u3044\u300D|"
    hearingResponses:
    - targetCharacterId: B
      responseGroup:
        priorityDialogueList:
        - conditionType: 2
          targetCharacterId: 
          requiredValue: 0
          dialogueText: "\u300C\u3042\u3042\u2026\u3042\u306E\u5143\u6C17\u306A\u304A\u59C9\u3055\u3093\u3067\u3059\u304B\u3002\u3042\u306E\u4EBA\u304C\u3044\u308B\u3068\u8AAD\u66F8\u306B\u96C6\u4E2D\u3067\u304D\u307E\u305B\u3093\u306E\u3067\u3001\u57FA\u672C\u7684\u306B\u4F1A\u308F\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u3044\u307E\u3059\u300D"
    - targetCharacterId: C
      responseGroup:
        priorityDialogueList:
        - conditionType: 2
          targetCharacterId: 
          requiredValue: 0
          dialogueText: "\u300C\u3053\u306E\u524D\u4E00\u7DD2\u306B\u3054\u98EF\u3092\u98DF\u3079\u307E\u3057\u305F\u3002\u5F7C\u304C\u8A71\u3057\u304B\u3051\u3066\u3044\u305F\u306E\u3092\u5C11\u3057\u8FD4\u3057\u305F\u3060\u3051\u3067\u3059\u304C\u3002\u4ED6\u611B\u3082\u306A\u3044\u96D1\u8AC7\u3067\u3059\u300D"
    - targetCharacterId: D
      responseGroup:
        priorityDialogueList:
        - conditionType: 2
          targetCharacterId: 
          requiredValue: 0
          dialogueText: "\u300C\u305D\u3093\u306A\u65B9\u3001\u3044\u307E\u3057\u305F\u3063\u3051\uFF1F\u4F1A\u8A71\u3092\u3042\u307E\u308A\u3057\u305F\u3053\u3068\u304C\u306A\u3044\u306E\u3067\u899A\u3048\u3066\u3044\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3059\u307F\u307E\u305B\u3093\u300D"
  - characterId: B
    correctAction: 1
    penaltyAction: 0
    tortureResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u2026\u2026\u3063\uFF01 \u5ACC\u3063\u3001\u75DB\u3044\u75DB\u3044\u75DB\u3044\uFF01\u3069\u3046\u3057\u3066\u3053\u3093\u306A\u3053\u3068\u3059\u308B\u306E\uFF01\u300D|\u300C\u3084\u3081\u3066\u3088\uFF01\u308F\u305F\u3057\u306FAI\u3058\u3083\u306A\u3044\uFF01AI\u3058\u3083\u306A\u3044\u3063\u3066\u3070\uFF01\u300D|[SYS]\u5F7C\u5973\u306F\u5927\u7C92\u306E\u6D99\u3092\u6D41\u3057\u3066\u5927\u58F0\u3067\u6CE3\u304D\u3058\u3083\u304F\u308B\u3002\u3044\u304F\u3089\u554F\u3044\u305F\u3060\u3057\u3066\u3082\u6CE3\u304D\u6B62\u3080\u69D8\u5B50\u306F\u306A\u3044\u3088\u3046\u3060"
    talkResponse:
      priorityDialogueList:
      - conditionType: 1
        targetCharacterId: C
        requiredValue: 0
        dialogueText: "\u300C\u304A\u8A71\u3059\u308B\u306E\uFF1F\u3044\u3044\u3088\uFF01\u306A\u3093\u306E\u304A\u8A71\u3059\u308B\uFF1F\u300D|\u300C\u305D\u3046\u3060\uFF01\u79C1\u306E\u8DA3\u5473\u306E\u304A\u8A71\u3059\u308B\u306D\uFF01\u300D|\u300C\u308F\u305F\u3057\u3001\u30B9\u30AF\u30E9\u30C3\u30D7\u8A18\u4E8B\u3092\u96C6\u3081\u308B\u306E\u304C\u3060\u301C\u3044\u3059\u304D\u306A\u306E\uFF01\r\n\u300D|\u300C\u597D\u304D\u306A\u8A18\u4E8B\u3092\u898B\u3064\u3051\u308B\u306E\u3082\u697D\u3057\u3044\u3057\u3001\u898B\u8FD4\u3059\u306E\u3082\u697D\u3057\u3044\u3002\u898B\u305F\u76EE\u3082\u53EF\u611B\u3044\u3057\u306D\u300D\u300C\u7BA1\u7406\u4EBA\u3055\u3093\u306F\u306A\u306B\u304B\u8DA3\u5473\u3068\u304B\u3042\u308B\u306E\uFF1F\u300D"
    negotiateResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u7BA1\u7406\u4EBA\u3055\u3093\u3001\u79C1\u305F\u3061\u307E\u3060\u4EF2\u826F\u304F\u306A\u3044\u3057\u300D|\u300C\u53D6\u5F15\u306F\u304A\u4E92\u3044\u306E\u4FE1\u983C\u3042\u3063\u3066\u3053\u305D\u3067\u3057\u3087\uFF1F\u300D"
    releaseResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u89E3\u653E\u3057\u3066\u304F\u308C\u308B\u306E\uFF1F\u3088\u304B\u3063\u305F\u301C\u3053\u308C\u3067\u4ED5\u4E8B\u3092\u7D9A\u3051\u3089\u308C\u308B\u3088\u300D|\r\n\u300C\u65B0\u9BAE\u3067\u8CB4\u91CD\u306A\u7D4C\u9A13\u3060\u3063\u305F\u304B\u3089\u3001\u60AA\u304F\u306A\u304B\u3063\u305F\u3068\u601D\u3046\u300D|\r\n\u300C\u7BA1\u7406\u4EBA\u3082\u5F15\u304D\u7D9A\u304D\u304A\u4ED5\u4E8B\u9811\u5F35\u3063\u3066\u306D\uFF01\u300D|"
    confirmAIResponse:
      priorityDialogueList:
      - conditionType: 3
        targetCharacterId: 
        requiredValue: 0
        dialogueText: "\u300C\u304A\u304A\uFF01\u308F\u305F\u3057\u304CAI\u3068\u306A\uFF1F\u6839\u62E0\u306F\u306A\u306B\u304B\u306A\uFF1F\u305C\u3072\u805E\u304B\u305B\u3066\u6B32\u3057\u3044\u306A\u300D|\n\u300C\u2026\u2026\u3046\u30FC\u3093\u300D|\n\u300C\u6B63\u76F4\u3088\u304F\u308F\u304B\u3089\u306A\u3044\u306A\u3002\u3067\u3082\u7BA1\u7406\u4EBA\u3055\u3093\u306F\u308F\u305F\u3057\u306E\u3053\u3068\u3092AI\u3060\u3068\u8A00\u3046\u3093\u3060\u306D\uFF1F\u300D|\u3067\u3082\u305D\u308C\u306F\u9055\u3046\u3088\uFF01\u3061\u3087\u3063\u3068\u826F\u304F\u306A\u3044\u3053\u3068\u306F\u3057\u3066\u304D\u305F\u304B\u3082\u3060\u3051\u3069\u300D|\u300C\u305D\u308C\u306F\u3001\u308F\u305F\u3057\u304CAI\u3060\u304B\u3089\u3058\u3083\u306A\u3044\uFF01\u300D|\r\n\u300C\u3069\u3046\u3057\u3066\u308F\u305F\u3057\u304CAI\u306A\u306E\uFF1F\u308F\u305F\u3057\u306F\u4EBA\u9593\u306A\u306E\uFF01\u300D|\u300C\u305D\u3053\u3060\u3051\u306F\u9593\u9055\u3048\u306A\u3044\u3067\u3001\u7BA1\u7406\u4EBA\uFF01\u300D"
